; polytest.vtms — staged-entry polyphony test: one voice joins
; every 20 rows (channel 0, then +1, then +2, then +3), all sustained
; (DECAY=0) so any dropout of an earlier voice is unmistakable.

TEMPO 10
LOOP 0

INSTRUMENT 0 WAVE=PULSE PW=32 VOL=63 PAN=LR DECAY=0
INSTRUMENT 1 WAVE=SAWTOOTH PW=0 VOL=63 PAN=LR DECAY=0
INSTRUMENT 2 WAVE=TRIANGLE PW=0 VOL=63 PAN=LR DECAY=0
INSTRUMENT 3 WAVE=PULSE PW=8 VOL=63 PAN=LR DECAY=0

PATTERN 0
