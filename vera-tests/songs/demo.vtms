; demo.vtms — short VTM demo tune (lead + bass + noise hat on 3 channels,
; 4th channel unused). Compile with:
;   python3 ../tools/vtm_compile.py demo.vtms DEMO.VTM

TITLE "Demo"
TEMPO 6
LOOP 0

INSTRUMENT 0 WAVE=PULSE    PW=32 VOL=40 PAN=LR   ; lead
INSTRUMENT 1 WAVE=TRIANGLE PW=0  VOL=48 PAN=LR   ; bass
INSTRUMENT 2 WAVE=NOISE    PW=16 VOL=20 PAN=LR   ; hat

PATTERN 0
C-4:0  C-2:1  ...    C-4:2
...    ...    ...    ...
E-4:0  ...    ...    C-4:2
...    ...    ...    ...
G-4:0  G-2:1  ...    C-4:2
...    ...    ...    ...
E-4:0  ...    ...    C-4:2
...    ...    ...    ...
C-4:0  C-2:1  ...    C-4:2
...    ...    ...    ...
D-4:0  ...    ...    C-4:2
...    ...    ...    ...
E-4:0  F-2:1  ...    C-4:2
...    ...    ...    ...
OFF    OFF    ...    OFF
...    ...    ...    ...

PATTERN 1
G-4:0  C-2:1  ...    C-4:2
...    ...    ...    ...
E-4:0  ...    ...    C-4:2
...    ...    ...    ...
D-4:0  G-2:1  ...    C-4:2
...    ...    ...    ...
C-4:0  ...    ...    C-4:2
...    ...    ...    ...
D-4:0  F-2:1  ...    C-4:2
...    ...    ...    ...
E-4:0  ...    ...    C-4:2
...    ...    ...    ...
G-4:0  C-2:1  ...    C-4:2
...    ...    ...    ...
OFF    OFF    ...    OFF
...    ...    ...    ...

ORDER 0 1
